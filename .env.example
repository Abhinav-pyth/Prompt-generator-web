# ============================================
# AI Prompt Studio - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# NEVER use real API keys in this example file.

# --------------------------------------------
# Application
# --------------------------------------------
# Public URL where the app is deployed
VITE_APP_URL=https://your-domain.vercel.app

# --------------------------------------------
# AI Provider (Optional)
# --------------------------------------------
# Configure ONE of the following providers to enable AI-powered generation.
# The local prompt builder works without any API keys.
# These are SERVER-SIDE only variables — never expose them in VITE_ prefixed vars.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google (Gemini)
GOOGLE_AI_API_KEY=

# Choose which provider to use: anthropic | openai | google | none
AI_PROVIDER=none

# --------------------------------------------
# Reference Analysis (Optional)
# --------------------------------------------
# Configure a browser inspection service to analyze reference URLs.
# Without this, reference URLs are noted but not analyzed.

# URL inspection service endpoint
REFERENCE_ANALYSIS_URL=

# API key for the reference analysis service
REFERENCE_ANALYSIS_API_KEY=

# --------------------------------------------
# Database (Optional - for persistence)
# --------------------------------------------
# Configure PostgreSQL + Prisma for saved projects and history.
# Without this, history is stored in browser localStorage.

DATABASE_URL=

# --------------------------------------------
# Authentication (Optional)
# --------------------------------------------
# Configure authentication for user accounts.
# Without this, the app works anonymously.

AUTH_SECRET=
NEXTAUTH_URL=

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------
# Billing (Optional)
# --------------------------------------------
# Configure Stripe for subscription billing.
# Without this, the app is free to use.

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------
# Rate Limiting (Optional)
# --------------------------------------------
# Configure rate limits for API endpoints.

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# --------------------------------------------
# Analytics (Optional)
# --------------------------------------------
# Configure analytics providers.

# Vercel Analytics (auto-enabled on Vercel)
# VERCEL_ANALYTICS_ID=
